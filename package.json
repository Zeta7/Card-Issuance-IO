{
  "name": "backend-io",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "type": "commonjs",
  "workspaces": [
    "card-issuer",
    "card-processor"
  ],
  "scripts": {
    "dev:issuer": "npm run dev --workspace=card-issuer",
    "dev:processor": "npm run dev --workspace=card-processor",
    "build": "npm run build --workspace=card-issuer && npm run build --workspace=card-processor",
    "lint": "eslint \"card-issuer/{src,test}/**/*.ts\" \"card-processor/{src,test}/**/*.ts\"",
    "format": "prettier --write \"card-issuer/{src,test}/**/*.ts\" \"card-processor/{src,test}/**/*.ts\"",
    "test": "npm run test --workspace=card-issuer && npm run test --workspace=card-processor"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.19.0"
  }
}
