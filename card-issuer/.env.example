PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# LOG_LEVEL controla el nivel minimo de logs que se muestran (pino).
# Cada nivel incluye los suyos y los de mayor severidad (de menos a mas critico):
#   trace -> maximo detalle: valores internos, pasos intermedios de cada funcion (muy verboso, solo debug puntual)
#   debug -> informacion util para depurar: payloads recibidos, decisiones de flujo, queries ejecutadas
#   info  -> eventos normales de negocio: request recibido, tarjeta emitida, evento publicado (recomendado en development)
#   warn  -> situaciones anormales pero no fatales: reintentos, datos faltantes con fallback, configuracion deprecada
#   error -> fallos que impiden completar una operacion puntual (ej. fallo al publicar en Kafka, request fallido)
#   fatal -> errores que obligan a detener el proceso (ej. no se pudo conectar a la base de datos al iniciar)
#   silent -> desactiva todos los logs
# En production se recomienda "info" o "warn" para reducir ruido; usar "debug"/"trace" solo al investigar un problema.
LOG_LEVEL=info

KAFKA_CLIENT_ID=card-issuer
KAFKA_BROKERS=localhost:9092
DB_HOST=localhost
DB_PORT=5432
DB_USER=card_issuer
DB_PASSWORD=card_issuer
DB_NAME=card_issuer
