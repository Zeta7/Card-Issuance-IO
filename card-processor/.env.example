NODE_ENV=development

# LOG_LEVEL controla el nivel minimo de logs que se muestran (pino).
# Cada nivel incluye los suyos y los de mayor severidad (de menos a mas critico):
#   trace -> maximo detalle: valores internos, pasos intermedios de cada funcion (muy verboso, solo debug puntual)
#   debug -> informacion util para depurar: mensajes consumidos, decisiones de flujo, reintentos en curso
#   info  -> eventos normales de negocio: mensaje consumido, tarjeta procesada, evento publicado (recomendado en development)
#   warn  -> situaciones anormales pero no fatales: reintento de mensaje, mensaje enviado a DLQ
#   error -> fallos que impiden procesar un mensaje puntual (ej. error de deserializacion, fallo al publicar)
#   fatal -> errores que obligan a detener el proceso (ej. no se pudo conectar a Kafka al iniciar)
#   silent -> desactiva todos los logs
# En production se recomienda "info" o "warn" para reducir ruido; usar "debug"/"trace" solo al investigar un problema.
LOG_LEVEL=info

KAFKA_CLIENT_ID=card-processor
KAFKA_BROKERS=localhost:9092
